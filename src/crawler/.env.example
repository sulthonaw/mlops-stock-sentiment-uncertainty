# ========================================================
# Kredensial Sesi X (Twitter)
# Ambil dari Cookie browser:
# F12 -> Application -> Storage -> Cookies -> https://x.com
# ========================================================
AUTH_TOKEN=your_auth_token_here
CT0=your_ct0_csrf_token_here

# Konfigurasi Crawl
# Contoh target:
# https://x.com/home
# https://x.com/search?q=teknologi%20AI&f=live
TARGET_URL=https://x.com/home
MAX_TWEETS=50
HEADLESS=true
OUTPUT_FILE=tweets_output.csv
